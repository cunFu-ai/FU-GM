<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fugm.http</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__FU_GM_RUNTIME_HOME__/run_fu_gm_http.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__FU_GM_RUNTIME_HOME__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__FU_GM_RUNTIME_HOME__/logs/fu_gm_http_server.launchd.log</string>

  <key>StandardErrorPath</key>
  <string>__FU_GM_RUNTIME_HOME__/logs/fu_gm_http_server.launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>
    <string>__FU_GM_RUNTIME_HOME__/src</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
