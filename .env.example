# FU-GM 最小配置示例。复制为 .env 后再填入真实值；不要提交 .env。
# 当前解析器只保证简单的 KEY=value。不要写 export、命令替换或 shell 表达式。

# 主线统一使用 DeepSeek 官方接口与 deepseek-v4-flash。Python 继续掌握规则、
# 权限、骰子、资源、回合和状态写入；模型只负责语义决策及受约束文本。
FU_GM_API_BASE_URL=https://api.deepseek.com
FU_GM_API_KEY=replace-with-your-deepseek-api-key
FU_GM_ACTION_MODEL=deepseek-v4-flash
FU_GM_EXPRESSOR_MODEL=deepseek-v4-flash
FU_GM_ACTION_API_BASE_URL=https://api.deepseek.com
FU_GM_EXPRESSOR_API_BASE_URL=https://api.deepseek.com
FU_GM_THINKING_ENABLED=false
FU_GM_ACTION_THINKING=off
FU_GM_EXPRESSOR_THINKING=off
FU_GM_DEEPSEEK_ROLEPLAY_MODE=default

# 普通 GM 回复由核心循环直接生成最终成品，不再追加一次外层表达器调用。
# expressor 模式仅用于显式回滚；规则结果的确定性渲染不会请求模型。
FU_GM_PUBLIC_EXPRESSION_MODE=core
FU_GM_EXPRESSOR_RULE_RESULT_PROSE_ENABLED=0

# 第一章邀请提交后，在后台只生成私密场次契约并持久化；玩家同意时由一个
# start_adventure 事务完成开章与首场。legacy 可随时回到原来的两轮工具链。
FU_GM_ADVENTURE_OPENING_FLOW_MODE=optimized
FU_GM_ADVENTURE_OPENING_PREFETCH_TIMEOUT_SECONDS=65

# intent 只暴露高置信意图对应的固定工具包；歧义或路由异常自动回旧热工具集。
# summary_delta只在同一次核心Agent事务内复用初始权威投影，不跨消息持久累积。
# 如需排障回滚，可临时改为 shadow + full，不需要改源码。
FU_GM_CAPABILITY_ROUTING_MODE=intent
FU_GM_STATE_CONTEXT_MODE=summary_delta

# 场次暗线、开场、转场、收束、NPC登场和命刻氛围文字由创作作者负责。
# 显式锁定场次作者，避免将来修改其他组件时发生路由漂移。
FU_GM_CREATIVE_API_BASE_URL=https://api.deepseek.com
FU_GM_CREATIVE_MODEL=deepseek-v4-flash
FU_GM_CREATIVE_THINKING=off
FU_GM_CREATIVE_TIMEOUT_SECONDS=120
FU_GM_CREATIVE_ENDPOINT_ATTEMPT_TIMEOUT_SECONDS=45

# NPC立场由核心循环决定；声线模型只改口吻，不改结构化内容。
FU_GM_NPC_DESIGN_API_BASE_URL=https://api.deepseek.com
FU_GM_NPC_DESIGN_MODEL=deepseek-v4-flash
FU_GM_NPC_DESIGN_THINKING=off
# NPC战斗蓝图使用严格single-flight；后台一次只跑一个，并在开场回复
# 关键路径之后再开始占用供应商并发。同步规则请求会提升并复用同一任务。
FU_GM_NPC_BLUEPRINT_MAX_WORKERS=1
FU_GM_NPC_BLUEPRINT_BACKGROUND_DEFER_SECONDS=20
FU_GM_NPC_VOICE_ENABLED=1
FU_GM_NPC_VOICE_MODEL=deepseek-v4-flash
FU_GM_NPC_VOICE_API_BASE_URL=https://api.deepseek.com
FU_GM_NPC_VOICE_THINKING=off
# 默认不再调用第二个模型复核；可选值：off / high_risk / all。
# FU_GM_NPC_VOICE_AUDIT_MODE=off
# FU_GM_NPC_VOICE_MAX_OUTPUT_TOKENS=900

# 可选备用端点，多个地址用英文逗号分隔。
FU_GM_BACKUP_API_BASE_URLS=

# 核心 GM 必须在线成功；不会用启发式主持器冒充成功。
FU_GM_CORE_AGENT_ENABLED=1
FU_GM_CORE_GM_MODEL=deepseek-v4-flash
FU_GM_TOOL_AGENT_MODEL=deepseek-v4-flash
FU_GM_TOOL_PROTOCOL_REPAIR_MODEL=deepseek-v4-flash
FU_GM_REPLY_GROUNDING_MODEL=deepseek-v4-flash
FU_GM_CORE_GM_TIMEOUT_SECONDS=90
FU_GM_CORE_GM_ENDPOINT_ATTEMPT_TIMEOUT_SECONDS=20
FU_GM_CORE_GM_REASONING_EFFORT=
FU_GM_CORE_GM_THINKING=off
FU_GM_CORE_GM_RESPONSE_FORMAT_ENABLED=1

# 全局请求恢复与提示词缓存。
FU_GM_TIMEOUT_SECONDS=120
FU_GM_ENDPOINT_ATTEMPT_TIMEOUT_SECONDS=30
FU_GM_REACTIVE_RECOVERY_ENABLED=1
FU_GM_REACTIVE_RECOVERY_MAX_RETRIES=2
FU_GM_RESPONSE_FORMAT_ENABLED=1
FU_GM_PROMPT_CACHE_ENABLED=1
FU_GM_PROMPT_CACHE_MODE=auto

# 核心GM上下文治理。仅压缩发给模型的临时视图，不影响存档、角色卡、
# 命刻、完整聊天和审计回执。通常保持默认值即可。
FU_GM_CONTEXT_WARNING_CHARS=32000
FU_GM_CONTEXT_PROACTIVE_CHARS=40000
FU_GM_CONTEXT_HARD_CHARS=48000
FU_GM_CONTEXT_TARGET_CHARS=32000
FU_GM_CONTEXT_RECENT_MESSAGE_LIMIT=8
FU_GM_CONTEXT_HISTORY_LIMIT=8
FU_GM_CONTEXT_FULL_HISTORY_ENTRIES=2

# HTTP 服务默认只监听本机。不要在没有认证和防火墙时改为 0.0.0.0。
FU_GM_HTTP_HOST=127.0.0.1
FU_GM_HTTP_PORT=8765
FU_GM_HTTP_MAX_BODY_BYTES=1048576
FU_GM_DATA_ROOT=data/campaigns

# 可选人格文档。
FU_GM_STYLE_FILE=config/gm_styles/acg_highschool_gm.md
